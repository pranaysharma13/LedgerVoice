# Copy to .env and fill in. Never commit .env (it is gitignored, and gitleaks checks commits).

# --- Anthropic ---------------------------------------------------------------
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
CLAUDE_EFFORT=low

# --- Cartesia ----------------------------------------------------------------
CARTESIA_API_KEY=
# Dated API version header. If an endpoint rejects it, its error lists accepted values.
CARTESIA_VERSION=2026-08-14
CARTESIA_TTS_MODEL=sonic-3.6
CARTESIA_STT_MODEL=ink-whisper
CARTESIA_VOICE_ID=47c38ca4-5f35-497b-b1a3-415245fb35e1

# --- Capital One Nessie ------------------------------------------------------
NESSIE_API_KEY=
NESSIE_BASE_URL=http://api.nessieisreal.com

# --- Moss --------------------------------------------------------------------
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=
